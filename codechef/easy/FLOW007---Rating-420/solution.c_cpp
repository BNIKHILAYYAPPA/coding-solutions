#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
    int n;
    cin>>n;
    while(n--){
        int a,di=0,r=0;
        cin>>a;
        while(a){
            di=a%10;
            r=r*10+di;
            a=a/10;
        }
        cout<<r<<"\n";
    }
    return 0;
}
