#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
	int n;
    cin>>n;
    while(n--){
        int a; 
        cin>>a;
        if(a<=100){
            cout<<a<<"\n";
        }
        else if (a<=1000){
            cout<<a-25<<"\n";
        }
        else if(a<=5000){
            cout<<a-100<<"\n";
        }
        else{
            cout<<a-500<<"\n";
        }
    }
    return 0;
}
