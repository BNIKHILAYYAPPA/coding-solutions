#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
        int n,r;
        cin>>n;
        while(n--){
            int a,b,c;
            cin>>a>>b>>c;
            r=a+b+c;
            if(r>1){
                cout<<"Not now\n";
            }
            else{
                cout<<"Water filling time\n";
            }
        }
        return 0;
}
