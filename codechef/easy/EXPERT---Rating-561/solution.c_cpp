#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
    int n;
    cin>>n;
    while(n--){
        double a,b;
        cin>>a>>b;
        if(((b/a)*100)>=50){
            cout<<"YES\n";
        }
        else{
            cout<<"NO\n";
        }
    }
