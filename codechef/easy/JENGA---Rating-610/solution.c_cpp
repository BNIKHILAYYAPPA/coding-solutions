#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
     int n;
     cin>>n;
     while(n--){
         int a,b,c;
         cin>>a>>b>>c;
         if(c%b==0&&a*b>=c){
             cout<<"YES\n";
         }
         else{
             cout<<"NO\n";
         }
     }
     return 0;
}
