#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
    int n;
    cin>>n;
    while(n--){
        int a,b;
        cin>>a>>b;
        if(a<b){
            cout<<"BIKE\n";
        }
        else if(a>b){
            cout<<"CAR\n";
        }
        else{
            cout<<"SAME\n";
        }
    }
    return 0;
}
