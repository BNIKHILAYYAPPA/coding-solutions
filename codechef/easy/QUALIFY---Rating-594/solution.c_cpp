#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
    int n;
    cin>>n;
    while(n--){
        int a,b,c;
        cin>>a>>b>>c;
        if(a<=(b*1+c*2)){
            cout<<"Qualify\n";
        }
        else{
            cout<<"Not Qualify\n";
        }
    }
    return 0;
}
