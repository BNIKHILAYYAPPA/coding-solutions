#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
    int n;
    cin>>n;
    while(n--){
        int a,b,c,d,sum=0;
        cin>>a>>b>>c>>d;
        if(a>b){
            sum+=a;
        }
        else{
            sum+=b;
        }
        if(c>d){
            sum+=c;
        }
        else{
            sum+=d;
        }
        cout<<sum<<"\n";
    }
    return 0;
}
