#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
     int n;
     cin>>n;
     while(n--){
         int a,b,c;
         cin>>a>>b>>c;
         if(a>=b&&a>=c){
             cout<<a<<"\n";
         }
         else if(b>=a&&b>=c){
             cout<<b<<"\n";
         }
         else{
             cout<<c<<"\n";
         }
     }
     return 0;
}
