#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
    int n;
    cin>>n;
    while(n--){
        int a,b,c,d;
        cin>>a>>b;
        cin>>c>>d;
        if(((c<=a+2) && (b==d)) || ( (d<=b+2) && (a==c))){
            cout<<"POSSIBLE\n";
        }
        else{
            cout<<"IMPOSSIBLE\n";
        }
    }
    return 0;
}
